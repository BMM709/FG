-- ลูปการทำงานหลัก (RenderStepped)
-- ==========================================
local RunService = game:GetService("RunService")

RunService.RenderStepped:Connect(function()
   -- 1. ระบบกันตกแมพ
   if antiFallEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
      local hrp = LocalPlayer.Character.HumanoidRootPart
      if hrp.Position.Y < -30 then
         hrp.CFrame = CFrame.new(hrp.Position.X, 20, hrp.Position.Z)
         hrp.Velocity = Vector3.new(0, 0, 0)
      end
   end

   -- 2. ระบบหยุดเวลา (Time Stop)
   if timeStopEnabled then
      for _, v in ipairs(workspace:GetDescendants()) do
         if v:IsA("BasePart") and not v.Anchored then
            local isLocalChar = LocalPlayer.Character and v:IsDescendantOf(LocalPlayer.Character)
            if not isLocalChar then
               if originalAnchoredStates[v] == nil then
                  originalAnchoredStates[v] = v.Anchored
               end
               v.Anchored = true
            end
         end
      end
   end

   -- 3. ระบบ Noclip
   if noclipEnabled and LocalPlayer.Character then
      for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
         if part:IsA("BasePart") then part.CanCollide = false end
      end
   end

   -- 4. ระบบเดินกลางอากาศ
   if airWalkEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
      local hrp = LocalPlayer.Character.HumanoidRootPart
      if not airWalkPart or not airWalkPart.Parent then
         airWalkPart = Instance.new("Part")
         airWalkPart.Name = "AirWalkPlatform"
         airWalkPart.Size = Vector3.new(4, 1, 4)
         airWalkPart.Transparency = 1
         airWalkPart.Anchored = true
         airWalkPart.CanCollide = true
         airWalkPart.Parent = workspace
      end
      airWalkPart.CFrame = hrp.CFrame - Vector3.new(0, 3.5, 0)
   else
      if airWalkPart then
         airWalkPart:Destroy()
         airWalkPart = nil
      end
   end

   -- 5. ระบบหลุมดำ
   if blackholeEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
      local myPos = LocalPlayer.Character.HumanoidRootPart.Position
      for _, p in ipairs(Players:GetPlayers()) do
         if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = p.Character.HumanoidRootPart
            hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(myPos + Vector3.new(0, 0, 3)), 0.2)
         end
      end
   end

   -- 6. ระบบ Hitbox & ESP
   for _, p in ipairs(Players:GetPlayers()) do
      if p ~= LocalPlayer and p.Character then
         local head = p.Character:FindFirstChild("Head")
         local hum = p.Character:FindFirstChildOfClass("Humanoid")
         if head and hum and hum.Health > 0 then
            if hitboxEnabled then
               head.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
               head.Transparency = 0.5
               head.CanCollide = false
            else
               head.Size = Vector3.new(2, 1, 1)
               head.Transparency = 0
            end
            
            local hl = p.Character:FindFirstChild("RayfieldHighlight")
            if not hl then
               hl = Instance.new("Highlight")
               hl.Name = "RayfieldHighlight"
               hl.FillColor = Color3.fromRGB(255, 255, 255)
               hl.OutlineColor = Color3.fromRGB(255, 255, 255)
               hl.FillTransparency = 0.5
               hl.OutlineTransparency = 0
               hl.Parent = p.Character
            end
            hl.Enabled = espHighlightEnabled
         end
      end
   end

   -- 7. ระบบ Aimbot
   if aimbotEnabled the
