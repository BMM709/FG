-- ระบบบิน (Fly)
local flying = false
local flySpeed = 50
local function toggleFly(state)
   flying = state
   local player = game.Players.LocalPlayer
   local char = player.Character
   if not char then return end
   local hrp = char:FindFirstChild("HumanoidRootPart")
   local hum = char:FindFirstChildOfClass("Humanoid")
   if not hrp or not hum then return end
   
   if flying then
      hum.PlatformStand = true
      local bg = Instance.new("BodyGyro", hrp)
      bg.Name = "RayfieldFlyGyro"
      bg.P = 9e4
      bg.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
      bg.CFrame = hrp.CFrame
      
      local bv = Instance.new("BodyVelocity", hrp)
      bv.Name = "RayfieldFlyVelocity"
      bv.Velocity = Vector3.new(0, 0, 0)
      bv.MaxForce = Vector3.new(9e4, 9e4, 9e4)
      
      task.spawn(function()
         local connection
         connection = game:GetService("RunService").RenderStepped:Connect(function()
            if not flying or not char or not hrp.Parent then
               if bg then bg:Destroy() end
               if bv then bv:Destroy() end
               if hum then hum.PlatformStand = false end
               if connection then connection:Disconnect() end
               return
            end
            local cam = workspace.CurrentCamera
            bg.CFrame = cam.CFrame
            local moveDir = hum.MoveDirection
            if moveDir.Magnitude > 0 then
               local camCFrame = cam.CFrame
               local relativeDir = camCFrame:VectorToObjectSpace(moveDir)
               bv.Velocity = (camCFrame.LookVector * -relativeDir.Z + camCFrame.RightVector * relativeDir.X) * flySpeed
            else
               bv.Velocity = Vector3.new(0, 0.1, 0)
            end
         end)
      end)
   else
      hum.PlatformStand = false
      if hrp:FindFirstChild("RayfieldFlyGyro") then hrp.RayfieldFlyGyro:Destroy() end
      if hrp:FindFirstChild("RayfieldFlyVelocity") then hrp.RayfieldFlyVelocity:Destroy() end
   end
end

